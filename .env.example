# Copy this file to `.env` and update values for your local environment.

# ─────────────────────────────────────────────────────────────────────────────
# ARSITEKTUR DUA LAYANAN
#   Vercel   = web (static) + API (serverless functions, /api/*)
#   Supabase = database (PostgreSQL) + storage (bucket "uploads")
#
# Local dev: node server.js  (API :3000, Vite :5173)
# Production: satu project Vercel melayani keduanya — tidak ada host lain.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL — Supabase (PostgreSQL, hosted)
# ─────────────────────────────────────────────────────────────────────────────
# Two supported forms (same credentials, different host/port):
#
#  1) LOCAL DEV & MIGRATIONS — session/direct connection (port 5432).
#     Prisma migrate needs a session, NOT the transaction pooler:
#     DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
#
#  2) VERCEL (SERVERLESS) — TRANSACTION pooler (port 6543 + pgbouncer). WAJIB.
#     Serverless membuka koneksi baru per invocation; tanpa pooler koneksi
#     Postgres akan habis (error "too many connections"). Tambahkan
#     `connection_limit=1` agar tiap function memakai 1 koneksi:
#     DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# Replace [REF] with your Supabase project ref and [PASSWORD] with the database
# password. If the password contains URL-special characters (? ! @ # etc.),
# URL-encode them in the connection string (e.g. ? -> %3F, ! -> %21, @ -> %40),
# otherwise Prisma will fail to parse the string (P1013).
#
# Note: the old host `db.<REF>.supabase.co` only resolves to IPv6 on projects
# without the IPv4 add-on, so use the pooler hostname above (IPv4) instead.
# Prisma 5 handles pgbouncer transaction mode out of the box with the flags
# above — schema.prisma needs no change.

DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────────────────────
# JWT — auth token signing (sama nilainya di local & Vercel)
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET="change_this_secret"

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE STORAGE — upload lampiran izin (pengganti disk uploads/)
# ─────────────────────────────────────────────────────────────────────────────
# Ambil dari Supabase Dashboard → Project Settings → API.
#   SUPABASE_URL                = Project URL, mis. https://[REF].supabase.co
#   SUPABASE_SERVICE_ROLE_KEY   = service_role SECRET key (server-side ONLY,
#                                 bypass RLS; JANGAN pernah expose ke client)
# File ter-upload jadi public URL:
#   https://[REF].supabase.co/storage/v1/object/public/uploads/<category>/...
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_SECRET_KEY]"

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEV ONLY — jangan set di Vercel
# ─────────────────────────────────────────────────────────────────────────────
PORT=3000
# VITE_API_URL hanya untuk `vite dev` lokal. Production web memakai same-origin
# `/api` (fallback bawaan src/utils/api.ts). VITE_API_BASE di mobile app
# (gopkl-student) adalah SECRET berisi URL penuh: https://<vercel-domain>/api
VITE_API_URL="http://localhost:3000"

# Keep this file out of source control when committing secrets. Use .env (local) instead.
