generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  teacher
  mentor
  hubin
  super_admin
}

enum AbsensiStatus {
  hadir
  izin
  sakit
  alpha
}

enum LogbookStatus {
  pending
  approved
  rejected
}

enum PermissionType {
  sakit
  izin
}

enum PermissionStatus {
  pending
  approved
  rejected
}

enum EvaluationType {
  dudi
  guru
}

model AcademicYear {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  users     User[]
  classes   Class[]
  companies Company[]

  @@map("academicyear")
}

model Class {
  id        Int      @id @default(autoincrement())
  name      String
  major     String?
  createdAt DateTime @default(now())

  academicYearId Int?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  users User[]

  @@index([academicYearId])
  @@map("class")
}

model Company {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  address      String
  city         String?
  country      String?
  phone        String?
  category     String?
  quota        Int      @default(0)
  latitude     Float?
  longitude    Float?
  radiusMeters Int      @default(500)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  academicYearId Int?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  mentorId Int?
  mentor   User? @relation("CompanyMentor", fields: [mentorId], references: [id])

  students User[] @relation("CompanyStudents")

  @@index([academicYearId])
  @@index([mentorId])
  @@map("company")
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  role     Role    @default(student)
  isActive Boolean @default(true)

  academicYear String?

  inactiveCategory String?
  inactiveReason   String?
  inactiveAt       DateTime?

  createdAt DateTime @default(now())

  academicYearId  Int?
  academicYearRef AcademicYear? @relation(fields: [academicYearId], references: [id])

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])

  teacherId Int?
  teacher   User?  @relation("StudentTeacher", fields: [teacherId], references: [id])
  students  User[] @relation("StudentTeacher")

  companyId Int?
  company   Company? @relation("CompanyStudents", fields: [companyId], references: [id])

  mentoredCompanies Company[] @relation("CompanyMentor")

  absensis    Absensi[]
  logbooks    Logbook[]
  permissions Permission[]

  evalAsStudent   Evaluation[] @relation("StudentEval")
  evalAsEvaluator Evaluation[] @relation("EvaluatorEval")

  @@index([academicYearId])
  @@index([classId])
  @@index([teacherId])
  @@index([companyId])
  @@map("user")
}

model Absensi {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  date        DateTime      @db.Date
  status      AbsensiStatus @default(hadir)
  checkInTime DateTime?
  imageUrl    String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime      @default(now())

  @@unique([userId, date])
  @@map("absensi")
}

model Logbook {
  id            Int           @id @default(autoincrement())
  userId        Int
  user          User          @relation(fields: [userId], references: [id])
  date          DateTime      @db.Date
  activityTitle String
  description   String        @db.Text
  hours         Int           @default(8)
  category      String?
  status        LogbookStatus @default(pending)
  feedback      String?       @db.Text
  createdAt     DateTime      @default(now())

  @@index([userId])
  @@map("logbook")
}

model Permission {
  id            Int              @id @default(autoincrement())
  userId        Int
  user          User             @relation(fields: [userId], references: [id])
  type          PermissionType
  reason        String
  attachmentUrl String?
  date          DateTime         @db.Date
  status        PermissionStatus @default(pending)
  rejectReason  String?
  createdAt     DateTime         @default(now())

  @@index([userId])
  @@map("permission")
}

model Evaluation {
  id          Int            @id @default(autoincrement())
  studentId   Int
  student     User           @relation("StudentEval", fields: [studentId], references: [id])
  evaluatorId Int
  evaluator   User           @relation("EvaluatorEval", fields: [evaluatorId], references: [id])
  type        EvaluationType
  score       Int
  notes       String?        @db.Text
  period      String
  createdAt   DateTime       @default(now())

  @@unique([studentId, evaluatorId, type, period])
  @@index([evaluatorId])
  @@map("evaluation")
}
