generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  teacher
  mentor
  hubin
  super_admin
}

enum AbsensiStatus {
  hadir
  izin
  sakit
  alpha
}

enum LogbookStatus {
  pending
  approved
  rejected
}

enum PermissionType {
  sakit
  izin
}

enum PermissionStatus {
  pending
  approved
  rejected
}

enum EvaluationType {
  dudi
  guru
}

model Class {
  id        Int      @id @default(autoincrement())
  name      String
  major     String?
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(student)
  isActive     Boolean  @default(true)
  academicYear String?
  createdAt    DateTime @default(now())

  classId   Int?
  class     Class?  @relation(fields: [classId], references: [id])
  teacherId Int?
  teacher   User?   @relation("StudentTeacher", fields: [teacherId], references: [id])
  students  User[]  @relation("StudentTeacher")

  absensis          Absensi[]
  logbooks          Logbook[]
  permissions       Permission[]
  evalAsStudent     Evaluation[] @relation("StudentEval")
  evalAsEvaluator   Evaluation[] @relation("EvaluatorEval")
}

model Absensi {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  date        DateTime      @db.Date
  status      AbsensiStatus @default(hadir)
  checkInTime DateTime?
  imageUrl    String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime      @default(now())

  @@unique([userId, date])
}

model Logbook {
  id            Int           @id @default(autoincrement())
  userId        Int
  user          User          @relation(fields: [userId], references: [id])
  date          DateTime      @db.Date
  activityTitle String
  description   String        @db.Text
  hours         Int           @default(8)
  category      String?
  status        LogbookStatus @default(pending)
  feedback      String?       @db.Text
  createdAt     DateTime      @default(now())
}

model Permission {
  id            Int              @id @default(autoincrement())
  userId        Int
  user          User             @relation(fields: [userId], references: [id])
  type          PermissionType
  reason        String
  attachmentUrl String?
  date          DateTime         @db.Date
  status        PermissionStatus @default(pending)
  rejectReason  String?
  createdAt     DateTime         @default(now())
}

model Evaluation {
  id          Int            @id @default(autoincrement())
  studentId   Int
  student     User           @relation("StudentEval", fields: [studentId], references: [id])
  evaluatorId Int
  evaluator   User           @relation("EvaluatorEval", fields: [evaluatorId], references: [id])
  type        EvaluationType
  score       Int
  notes       String?        @db.Text
  period      String
  createdAt   DateTime       @default(now())

  @@unique([studentId, evaluatorId, type, period])
}
