generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  teacher
  mentor
  hubin
}

enum AbsensiStatus {
  hadir
  izin
  sakit
  alpha
}

enum LogbookStatus {
  pending
  approved
  rejected
}

enum PermissionType {
  sakit
  izin
}

enum PermissionStatus {
  pending
  approved
  rejected
}

enum EvaluationType {
  dudi
  guru
}

model AcademicYear {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  users     User[]
  classes   Class[]
  companies Company[]

  @@map("academicyear")
}

model ProgramKeahlian {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  concentrations       KonsentrasiKeahlian[]
  classes              Class[]
  achievementTemplates LearningAchievementTemplate[]

  @@map("program_keahlian")
}

model KonsentrasiKeahlian {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  programKeahlianId Int
  programKeahlian   ProgramKeahlian @relation(fields: [programKeahlianId], references: [id], onDelete: Cascade)

  classes Class[]

  @@unique([programKeahlianId, name])
  @@index([programKeahlianId])
  @@map("konsentrasi_keahlian")
}

model Class {
  id        Int      @id @default(autoincrement())
  name      String

  /// Kolom kompatibilitas untuk deployment lama. Diisi otomatis oleh trigger
  /// database dari Program Keahlian. Jangan dipakai untuk kode baru.
  major String?

  createdAt DateTime @default(now())

  academicYearId Int?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  // Program Keahlian (bidang/jurusan) dan Konsentrasi Keahlian (spesialisasi).
  programKeahlianId Int?
  programKeahlian   ProgramKeahlian? @relation(fields: [programKeahlianId], references: [id])

  konsentrasiKeahlianId Int?
  konsentrasiKeahlian   KonsentrasiKeahlian? @relation(fields: [konsentrasiKeahlianId], references: [id])

  users User[]

  @@index([academicYearId])
  @@index([programKeahlianId])
  @@index([konsentrasiKeahlianId])
  @@map("class")
}

model Company {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  address  String
  city     String?
  country  String?
  phone    String?
  category String?

  // Total kuota perusahaan untuk semua sekolah
  quotaSchool  Int @default(0)
  quotaCompany Int @default(0)
  quota        Int @default(0)

  latitude     Float?
  longitude    Float?
  radiusMeters Int     @default(500)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYearId Int?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  // Mentor yang sedang ditugaskan ke perusahaan.
  // Dipertahankan agar kompatibel dengan data lama.
  mentorId Int?
  mentor   User? @relation("CompanyMentor", fields: [mentorId], references: [id])

  // Daftar mentor yang terdaftar pada perusahaan.
  registeredMentors CompanyMentor[] @relation("CompanyMentorCompany")

  // Siswa yang ditempatkan di perusahaan.
  students User[] @relation("CompanyStudents")

  @@index([academicYearId])
  @@index([mentorId])
  @@map("company")
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String
  whatsapp      String?
  nis           String?   @unique
  gender        String?
  birthPlace    String?
  birthDate     DateTime? @db.Date
  nisn          String?
  nik           String?
  religion      String?
  concentration String?
  address       String?
  parentName    String?
  parentAddress String?
  parentPhone   String?
  nip           String?
  role          Role      @default(student)
  isActive      Boolean   @default(true)

  academicYear String?
  tefaCategory String? @db.VarChar(20)

  // Relasi pendaftaran mentor ke perusahaan.
  companyMentorRegistrations CompanyMentor[] @relation("UserMentorCompanies")

  inactiveCategory String?
  inactiveReason   String?
  inactiveAt       DateTime?

  createdAt DateTime @default(now())

  academicYearId  Int?
  academicYearRef AcademicYear? @relation(fields: [academicYearId], references: [id])

  // Relasi kelas siswa.
  classId Int?
  class   Class? @relation(fields: [classId], references: [id])

  // Relasi guru pembimbing dengan siswa.
  teacherId Int?
  teacher   User?  @relation("StudentTeacher", fields: [teacherId], references: [id])
  students  User[] @relation("StudentTeacher")

  // Relasi siswa dengan perusahaan PKL.
  companyId       Int?
  company         Company? @relation("CompanyStudents", fields: [companyId], references: [id])
  placementSource String?

  // Perusahaan yang saat ini menggunakan mentor tersebut.
  mentoredCompanies Company[] @relation("CompanyMentor")

  absensis    Absensi[]
  logbooks    Logbook[]
  permissions Permission[]

  evalAsStudent   Evaluation[] @relation("StudentEval")
  evalAsEvaluator Evaluation[] @relation("EvaluatorEval")

  // Capaian & tujuan pembelajaran logbook PKL.
  learningAchievements      LearningAchievement[] @relation("StudentLearningAchievements")
  mentorSignedAchievements  LearningAchievement[] @relation("AchievementMentorSigner")
  teacherSignedAchievements LearningAchievement[] @relation("AchievementTeacherSigner")
  learningGoals             LearningGoal[]        @relation("StudentLearningGoals")

  @@index([academicYearId])
  @@index([classId])
  @@index([teacherId])
  @@index([companyId])
  @@map("user")
}

model CompanyMentor {
  id        Int      @id @default(autoincrement())
  companyId Int
  mentorId  Int
  createdAt DateTime @default(now())

  company Company @relation("CompanyMentorCompany", fields: [companyId], references: [id], onDelete: Cascade)
  mentor  User    @relation("UserMentorCompanies", fields: [mentorId], references: [id], onDelete: Cascade)

  @@unique([companyId, mentorId])
  @@index([mentorId])
  @@map("company_mentor")
}

model Absensi {
  id           Int           @id @default(autoincrement())
  userId       Int
  user         User          @relation(fields: [userId], references: [id])
  date         DateTime      @db.Date
  status       AbsensiStatus @default(hadir)
  checkInTime  DateTime?
  checkOutTime DateTime?
  imageUrl     String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime      @default(now())

  @@unique([userId, date])
  @@map("absensi")
}

model Logbook {
  id            Int           @id @default(autoincrement())
  userId        Int
  user          User          @relation(fields: [userId], references: [id])
  date          DateTime      @db.Date
  activityTitle String
  description   String        @db.Text
  hours         Int           @default(8)
  category      String?
  status        LogbookStatus @default(pending)
  feedback      String?       @db.Text
  createdAt     DateTime      @default(now())

  @@index([userId])
  @@map("logbook")
}

model Permission {
  id            Int              @id @default(autoincrement())
  userId        Int
  user          User             @relation(fields: [userId], references: [id])
  type          PermissionType
  reason        String
  attachmentUrl String?
  date          DateTime         @db.Date
  status        PermissionStatus @default(pending)
  rejectReason  String?
  createdAt     DateTime         @default(now())

  @@index([userId])
  @@map("permission")
}

model Evaluation {
  id          Int            @id @default(autoincrement())
  studentId   Int
  student     User           @relation("StudentEval", fields: [studentId], references: [id])
  evaluatorId Int
  evaluator   User           @relation("EvaluatorEval", fields: [evaluatorId], references: [id])
  type        EvaluationType
  score       Int
  notes       String?        @db.Text
  period      String
  createdAt   DateTime       @default(now())

  @@unique([studentId, evaluatorId, type, period])
  @@index([evaluatorId])
  @@map("evaluation")
}

/// Template Capaian Pembelajaran per Program Keahlian.
/// Dikelola Hubin. Saat siswa pertama kali membuka capaian, baris template
/// disalin menjadi learning_achievement milik siswa tersebut.
model LearningAchievementTemplate {
  id         Int    @id @default(autoincrement())
  orderIndex Int
  title      String @db.Text

  programKeahlianId Int
  programKeahlian   ProgramKeahlian @relation(fields: [programKeahlianId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programKeahlianId, orderIndex])
  @@index([programKeahlianId])
  @@map("learning_achievement_template")
}

model LearningAchievement {
  id         Int     @id @default(autoincrement())
  studentId  Int
  student    User    @relation("StudentLearningAchievements", fields: [studentId], references: [id], onDelete: Cascade)
  orderIndex Int
  title      String  @db.Text
  evidence   String? @db.Text
  weeks      Int[]   @default([])

  // Paraf pembimbing dipisah: mentor (DUDI) dan guru/sekolah.
  mentorSignedAt   DateTime?
  mentorSignedById Int?
  mentorSignedBy   User?     @relation("AchievementMentorSigner", fields: [mentorSignedById], references: [id], onDelete: SetNull)

  teacherSignedAt   DateTime?
  teacherSignedById Int?
  teacherSignedBy   User?     @relation("AchievementTeacherSigner", fields: [teacherSignedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, orderIndex])
  @@index([studentId])
  @@index([mentorSignedById])
  @@index([teacherSignedById])
  @@map("learning_achievement")
}

model LearningGoal {
  id          Int     @id @default(autoincrement())
  studentId   Int
  student     User    @relation("StudentLearningGoals", fields: [studentId], references: [id], onDelete: Cascade)
  orderIndex  Int
  title       String  @db.Text
  score       Int?
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, orderIndex])
  @@index([studentId])
  @@map("learning_goal")
}
